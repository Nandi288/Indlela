@model string
@{
    ViewData["Title"] = "Check your email";
    var devLink = ViewData["DevConfirmationLink"] as string;
}

<div class="ip-page ip-page-narrow">
    <div class="ip-head">
        <div>
            <p class="ip-greet">One more step</p>
            <h1 class="ip-title">Check your email</h1>
        </div>
    </div>

    <section class="ip-card ip-hero" aria-labelledby="mail-title">
        <div class="ip-hero-strand" aria-hidden="true"></div>
        <div class="ip-hero-body">
            <h2 id="mail-title" class="ip-hero-title" style="font-size:1.4rem">We sent a verification link to <span class="accent">@Model</span></h2>
            <p class="ip-hero-text">Tap it within 24 hours to activate your account. Didn't get it? Check your spam folder.</p>
        </div>
    </section>

    @if (devLink is not null)
    {
        <section class="ip-card ip-card-pad" aria-labelledby="inbox-title" style="margin-top:18px">
            <p class="ip-greet" style="margin:0">Simulated inbox · demo mode</p>
            <h2 id="inbox-title" style="margin:6px 0 4px;font-size:1.15rem">Verify your Indlela account</h2>
            <p class="ip-muted" style="margin:0 0 12px">To: @Model · From: Indlela</p>
            <p style="margin:0 0 14px">Sawubona! Tap below to verify your email. In the live app this message arrives by email; for the demo it's shown here.</p>
            <a class="ip-btn ip-btn-gold" href="@devLink">Verify my email</a>
        </section>
    }
</div>
