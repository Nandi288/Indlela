@{
    ViewData["Title"] = "Link expired";
}

<div class="ip-page ip-page-narrow">
    <div class="ip-head">
        <div>
            <p class="ip-greet">Hmm</p>
            <h1 class="ip-title">That link didn't work</h1>
        </div>
    </div>
    <section class="ip-card ip-card-pad">
        <p style="margin:0 0 16px">Verification links expire after 24 hours, and each one works once. Please register again or contact support to get a new link.</p>
        <a class="ip-btn ip-btn-gold" href="/account/login">Go to log in</a>
    </section>
</div>
