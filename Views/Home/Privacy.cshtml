@{
    ViewData["Title"] = "Privacy & POPIA";
}

<div class="ip-page ip-page-narrow">
    <div class="ip-head">
        <div>
            <p class="ip-greet">Your data</p>
            <h1 class="ip-title">Privacy &amp; POPIA</h1>
            <p class="ip-lede">
                This page is a placeholder for Indlela's privacy notice under the Protection of Personal Information Act.
                Before real learner data is stored, the team must name an Information Officer, agree a retention period,
                and publish the final notice here.
            </p>
        </div>
    </div>

    <section class="ip-card ip-card-pad" aria-labelledby="cover-title">
        <h2 id="cover-title" class="ip-h2">What the notice needs to cover</h2>
        <ul class="ip-badge-rows">
            <li><span class="ip-diamond ip-diamond-sm" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12l5 5 9-10" /></svg></span><div>Which details we collect (name, email, mobile, province, career goal, optional ID/passport) and why.</div></li>
            <li><span class="ip-diamond ip-diamond-sm tone-1" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12l5 5 9-10" /></svg></span><div>Separate consent for your account, for sharing details with providers during sign-up, and for marketing email.</div></li>
            <li><span class="ip-diamond ip-diamond-sm tone-2" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12l5 5 9-10" /></svg></span><div>That your ID/passport number is encrypted, optional, never put in a link and never printed on your portfolio.</div></li>
            <li><span class="ip-diamond ip-diamond-sm" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12l5 5 9-10" /></svg></span><div>How to download your data or delete your account, and how long we keep it.</div></li>
            <li><span class="ip-diamond ip-diamond-sm tone-1" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12l5 5 9-10" /></svg></span><div>Extra wording for learners under 18.</div></li>
        </ul>
    </section>
</div>
