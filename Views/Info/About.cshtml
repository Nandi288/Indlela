@{
    ViewData["Title"] = "About us";
}

<div class="ix-page" style="max-width:1000px;margin:0 auto">
    <div>
        <p class="ix-kicker">About Indlela</p>
        <h1 class="ix-title">Indlela means "the way" in isiZulu.</h1>
        <p class="ix-lede">We're building the path from free learning to a first paid opportunity for young South Africans and anyone who wants to learn and earn.</p>
    </div>

    <div class="ix-grid">
        <section class="ix-glass">
            <h2>The problem</h2>
            <p style="margin:0">No experience, no job. No job, no experience. Free courses are scattered across many websites, most learners don't know which ones lead to work, and a certificate alone rarely convinces an employer.</p>
        </section>
        <section class="ix-glass">
            <h2>What we do</h2>
            <p style="margin:0">Indlela gives every learner a personal career roadmap, free data-light lessons and trusted provider courses, a verified skills portfolio, and job matches based on what they can prove.</p>
        </section>
        <section class="ix-glass">
            <h2>How we keep it fair</h2>
            <p style="margin:0">Free for learners, always. We only call a skill "verified" when Indlela can prove it, we follow POPIA, and we never put personal details in a link.</p>
        </section>
    </div>

    <section class="ix-glass">
        <h2>The team</h2>
        <p style="margin:0">Indlela is built by DOTNET NINJAS, a team of young developers from Durban University of Technology who live the problem we're solving.</p>
    </section>

    <div style="display:flex;gap:12px;flex-wrap:wrap">
        <a class="ix-btn-gold" href="/account/register">Start learning free</a>
        <a class="ix-btn-line" href="/employers">For employers</a>
    </div>
</div>
