@{
    ViewData["Title"] = "For employers";
}

<div class="ix-page" style="max-width:1000px;margin:0 auto">
    <div>
        <p class="ix-kicker">For employers</p>
        <h1 class="ix-title">Hire young talent with proof, not guesswork.</h1>
        <p class="ix-lede">Every Indlela learner builds a skills portfolio showing how each skill was proven: an Indlela quiz, a provider certificate or a real project.</p>
    </div>

    <div class="ix-grid">
        <section class="ix-glass">
            <h2>Verified skills</h2>
            <p style="margin:0">See exactly what a candidate can do and how it was proven, before you interview.</p>
        </section>
        <section class="ix-glass">
            <h2>Matched shortlists</h2>
            <p style="margin:0">Post a learnership, internship or entry-level role and see the learners whose skills fit it.</p>
        </section>
        <section class="ix-glass">
            <h2>Skills development you can report</h2>
            <p style="margin:0">Sponsor a career roadmap and track how many young people trained, finished and found work.</p>
        </section>
    </div>

    <section class="ix-glass">
        <h2>Partner with us</h2>
        <p style="margin:0 0 14px">We're onboarding our first employer and SETA partners. Tell us about the roles you hire for and we'll get in touch.</p>
        <a class="ix-btn-gold" href="mailto:partners@indlela.co.za?subject=Indlela%20employer%20partnership">Become a partner</a>
    </section>
    <p class="ix-muted" style="margin:0;font-size:.9rem">Learners choose whether their portfolio is public. We never share personal details without their consent (POPIA).</p>
</div>
