@model PortfolioVm
@{
    Layout = null; // ATS-friendly CV: one column, real text, standard headings, no tables or icons
    var p = Model.Profile;
    var verified = Model.Skills.Where(s => s.Proof == ProofKind.Verified).Select(s => s.Skill).ToList();
    var other = Model.Skills.Where(s => s.Proof != ProofKind.Verified).Select(s => s.Skill).ToList();
    var projects = Model.Skills.Where(s => s.Proof == ProofKind.Project).ToList();
    string Lines(string? text) => text ?? "";
}
<!DOCTYPE html>
<html lang="en-ZA">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.FullName CV</title>
    <style>
        @@page { size: A4; margin: 16mm; }
        body { font: 11pt/1.45 Arial, Helvetica, sans-serif; color: #000; margin: 0; background: #fff; }
        .cv { max-width: 720px; margin: 0 auto; padding: 24px; }
        h1 { font-size: 20pt; margin: 0 0 2px; }
        .sub { margin: 0; }
        h2 { font-size: 12pt; text-transform: uppercase; letter-spacing: .04em; margin: 18px 0 6px; padding-bottom: 2px; border-bottom: 1px solid #000; }
        p { margin: 0 0 6px; }
        ul { margin: 0; padding-left: 18px; }
        li { margin: 0 0 3px; }
        .pre { white-space: pre-line; }
        .bar { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; padding: 14px; background: #0A2A20; }
        .bar a, .bar button { font: 700 11pt Arial; padding: 10px 18px; border-radius: 999px; border: 0; cursor: pointer; text-decoration: none; }
        .bar button { background: #F0B43C; color: #17150D; }
        .bar a { color: #F4F1E8; border: 1px solid #E8B04B; }
        .tip { text-align: center; font-size: 10pt; color: #444; margin: 10px 16px 0; }
        @@media print { .bar, .tip { display: none; } .cv { padding: 0; } }
    </style>
</head>
<body>
    <div class="bar"><button type="button" onclick="window.print()">Save as PDF / print</button><a href="/portfolio">Back to my portfolio</a></div>
    <p class="tip">This CV uses a simple one-column layout so job-site scanners (ATS) can read it. Add your education and experience on your portfolio page.</p>

    <div class="cv">
        <h1>@Model.FullName</h1>
        @if (!string.IsNullOrWhiteSpace(p.Headline)) { <p class="sub">@p.Headline</p> }

        <h2>Contact</h2>
        <p>
            @if (!string.IsNullOrWhiteSpace(p.Location)) { <text>Location: @p.Location<br /></text> }
            @if (Model.Email is not null) { <text>Email: @Model.Email<br /></text> }
            @if (Model.Phone is not null) { <text>Phone: @Model.Phone<br /></text> }
            @if (p.IsPublic) { <text>Portfolio: @Model.ShareUrl</text> }
        </p>

        @if (!string.IsNullOrWhiteSpace(p.About))
        {
            <h2>Summary</h2>
            <p class="pre">@p.About</p>
        }

        <h2>Skills</h2>
        @if (Model.Skills.Count == 0)
        {
            <p>Skills appear here as roadmap steps are completed on Indlela.</p>
        }
        else
        {
            @if (verified.Count > 0) { <p>Verified skills: @string.Join(", ", verified)</p> }
            @if (other.Count > 0) { <p>Other skills: @string.Join(", ", other)</p> }
        }

        @if (Model.Courses.Count > 0)
        {
            <h2>Certifications and Courses</h2>
            <ul>
                @foreach (var c in Model.Courses)
                {
                    <li>@c.Title, @c.Provider@(c.Date is DateTime d ? $", {d:MMMM yyyy}" : "")@(c.Verified ? " (verified)" : "")</li>
                }
            </ul>
        }

        @if (projects.Count > 0)
        {
            <h2>Projects</h2>
            <ul>
                @foreach (var s in projects)
                {
                    <li>@s.Skill: @s.Source@(s.Link is null ? "" : $", {s.Link}")</li>
                }
            </ul>
        }

        @if (!string.IsNullOrWhiteSpace(p.InformalExperience))
        {
            <h2>Experience</h2>
            <p class="pre">@Lines(p.InformalExperience)</p>
        }

        @if (!string.IsNullOrWhiteSpace(p.Education))
        {
            <h2>Education</h2>
            <p class="pre">@Lines(p.Education)</p>
        }

        @if (Model.Badges.Count > 0)
        {
            <h2>Achievements</h2>
            <p>Indlela badges: @string.Join(", ", Model.Badges.Select(b => b.Name))</p>
        }
    </div>
</body>
</html>
