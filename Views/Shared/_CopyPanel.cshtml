@model IReadOnlyList<SharedFieldVm>

@if (Model.Count == 0)
{
    <p class="muted">Add your details in your profile to get copy buttons here.</p>
}
else
{
    <div>
        @foreach (var field in Model)
        {
            <div class="copy-row">
                <div>
                    <span class="label">@field.Label</span>
                    <span class="value">@field.DisplayValue</span>
                </div>
                <button type="button" class="btn btn-outline btn-sm" data-copy="@field.DisplayValue">Copy</button>
            </div>
        }
    </div>
}
